{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/journey.schema.json",
  "title": "Archify User Journey Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "journey"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "enum": [
            "trace",
            "none"
          ]
        },
        "persona": {
          "type": "string"
        }
      }
    },
    "extraRow": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "sentiment",
          "action"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sentiment": {
            "enum": [
              "high",
              "med-high",
              "neutral",
              "med-low",
              "low"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "touchpoint": {
            "type": "string"
          },
          "extra": {
            "type": "string",
            "minLength": 1
          },
          "pain": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  }
}
